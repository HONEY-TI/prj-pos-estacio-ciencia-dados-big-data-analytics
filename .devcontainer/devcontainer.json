{
  "name": "rstudio-dev-base",
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "rstudio",
  "remoteUser": "rstudio",
  "updateRemoteUserUID": true,
  "overrideCommand": false,
  "workspaceFolder": "/workspaces",
  "forwardPorts": [
    8787,
    8888,
    7077,
    8081,
    9870,
    9000,
    9864
  ],
  "mounts": [
    "type=volume,target=/home/node/.vscode-server",
    "source=${localEnv:HOME}/.ssh,target=/home/rstudio/.ssh,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "reditorsupport.r-syntax",
        "reditorsupport.r-syntax@0.1.4",
        "mikhail-arkhipov.r@0.0.32",
        "reditorsupport.r@2.8.8",
        "ms-python.debugpy",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-slideshow",
        "frhtylcn.pythonsnippets",
        "ericsia.pythonsnippets3",
        "mgesbert.python-path",
        "mikhail-arkhipov.r",
        "mathematic.vscode-pdf@0.2.1",
        "arturock.gitstash@6.13.0",
        "openai.chatgpt@26.825.51511"
      ]
    }
  }
}