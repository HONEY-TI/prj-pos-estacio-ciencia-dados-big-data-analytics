{
  "name": "rstudio-pos-devcontainer",
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "rstudio-pos-devcontainer",
  "remoteUser": "rstudio",
  "updateRemoteUserUID": false,
  "workspaceFolder": "/workspace",
  "initializeCommand": "f=$(ls -t \"${XDG_RUNTIME_DIR}\"/.mutter-Xwaylandauth.* 2>/dev/null | head -n1); if [ -n \"$f\" ]; then cp \"$f\" .devcontainer/.xauth-devc; else : > .xauth-devc; fi",
  "postStartCommand": "setup-codex.sh",
  "postCreateCommand": "sudo post-start.sh",
  "shutdownAction": "stopCompose",
  "containerEnv": {
    "IN_DEVCONTAINER": "true",
    "DISPLAY": ":0",
    "XAUTHORITY": "/tmp/.xauth-devc"
  },
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer/.xauth-devc,target=/tmp/.xauth-devc,type=bind,readonly",
    "source=vscode-server-rstudio,target=/home/rstudio/.vscode-server,type=volume",
    "source=${localEnv:HOME}/.ssh,target=/home/rstudio/.ssh,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "reditorsupport.r-syntax",
        "reditorsupport.r-syntax@0.1.4",
        "mikhail-arkhipov.r@0.0.32",
        "reditorsupport.r@2.8.8",
        "ms-python.debugpy",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-slideshow",
        "frhtylcn.pythonsnippets",
        "ericsia.pythonsnippets3",
        "mgesbert.python-path",
        "mikhail-arkhipov.r",
        "mathematic.vscode-pdf@0.2.1",
        "arturock.gitstash@6.13.0",
        "openai.chatgpt@26.825.51511"
      ]
    }
  }
}