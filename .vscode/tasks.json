{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Inicialização automática",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/.vscode/init-tasks"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false,
                "close": true,
                "showReuseMessage": false,
                "echo": false
            }
        }
    ]
}