{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Init Docker",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/init-docker",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "Update Submodules",
      "type": "shell",
      "command": "if [ -f .git/config.lock ]; then rm -f .git/config.lock; fi && git submodule sync --recursive && git submodule update --init --remote --force .ai",
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "close": true
      }
    }
  ]
}
