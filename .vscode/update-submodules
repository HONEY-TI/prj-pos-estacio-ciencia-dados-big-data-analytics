#!/usr/bin/env bash

set -u

echo "==> Atualizando submódulos..."

# ------------------------------------------------------------
# 0. Corrige o submódulo .ai quando estiver inconsistente
# ------------------------------------------------------------

echo "==> Verificando submódulo .ai..."
# Diretório onde este script está localizado (.vscode)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Diretório raiz do projeto 
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)" 

# Caminho absoluto do submódulo .ai 
AI_PATH="${PROJECT_DIR}/.ai"

if [ -f ".gitmodules" ] && git config -f .gitmodules --get "submodule.${AI_PATH}.path" >/dev/null 2>&1; then
    echo "    .ai encontrado no .gitmodules"

    # URL e branch definidos no .gitmodules
    AI_URL=$(git config -f .gitmodules --get "submodule.${AI_PATH}.url" || true)
    AI_BRANCH=$(git config -f .gitmodules --get "submodule.${AI_PATH}.branch" || true)

    # Valores padrão
    AI_URL="${AI_URL:-git@github.com:HONEY-TI/.ai.git}"
    AI_BRANCH="${AI_BRANCH:-main}"

    echo "    Path:   $AI_PATH"
    echo "    URL:    $AI_URL"
    echo "    Branch: $AI_BRANCH"

    # Remove o submódulo antigo do índice
    if git ls-files --error-unmatch "$AI_PATH" >/dev/null 2>&1; then
        echo "    Removendo registro antigo de .ai do índice..."
        git rm -r --cached "$AI_PATH" 2>/dev/null || true
    fi

    # Remove configuração antiga do .git/config
    git config --remove-section "submodule.${AI_PATH}" 2>/dev/null || true

    # Remove diretório físico
    if [ -e "$AI_PATH" ]; then
        echo "    Removendo diretório .ai antigo..."
        rm -rf "$AI_PATH"
    fi

    # Recria o submódulo SEMPRE na raiz
    echo "    Recriando submódulo .ai..."
    git submodule add -b "$AI_BRANCH" "$AI_URL" "$AI_PATH"

else
    echo "    .ai não está configurado no .gitmodules."
fi

# ------------------------------------------------------------
# 1. Remove locks
# ------------------------------------------------------------

echo "==> Removendo arquivos config.lock..."

find . \
    -name "config.lock" \
    -path "*/.git/*" \
    -delete 2>/dev/null || true


# ------------------------------------------------------------
# 2. Sincroniza URLs
# ------------------------------------------------------------

echo "==> Sincronizando URLs dos submódulos..."

git submodule sync --recursive


# ------------------------------------------------------------
# 3. Inicializa todos os submódulos
# ------------------------------------------------------------

echo "==> Inicializando submódulos..."

git submodule update --init --recursive


# ------------------------------------------------------------
# 4. Fetch em TODOS os submódulos
# ------------------------------------------------------------

echo "==> Executando fetch em todos os submódulos..."

git submodule foreach --recursive '
    echo "---- $name ----"
    git fetch origin || true
'


# ------------------------------------------------------------
# 5. Atualiza .ai a partir do branch remoto
# ------------------------------------------------------------

if git ls-files --error-unmatch .ai >/dev/null 2>&1; then
    echo "==> Atualizando .ai..."

    git submodule update --init --remote --force .ai

    git submodule update --remote --merge --recursive .ai
else
    echo "ERRO: .ai ainda não está registrado como submódulo."
    echo "Execute:"
    echo "    git add .gitmodules .ai"
    echo "    git commit -m \"Fix .ai submodule\""
    exit 1
fi


# ------------------------------------------------------------
# 6. Atualiza os demais submódulos
# ------------------------------------------------------------

echo "==> Atualizando demais submódulos..."

git submodule update --remote --merge --recursive


# ------------------------------------------------------------
# 7. Status final
# ------------------------------------------------------------

echo
echo "=========================================="
echo "Submódulos atualizados."
echo "=========================================="
echo

git submodule status --recursive

echo
echo "Git status:"
git status --short
