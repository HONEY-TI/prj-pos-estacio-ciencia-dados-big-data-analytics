#!/usr/bin/env bash
set -euo pipefail

# ─────────────────────────────────────────────────────────────────────────
# init-docker-servers
#
# Roda `make up` em .docker, somente no host (fora de container).
# A lógica de verificação, recuperação e ordem de inicialização fica
# toda no Makefile.
# ─────────────────────────────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
MAKE_INFRA_DIR="${WORKSPACE_DIR}/.docker"

log() {
  printf '[init-docker] %s\n' "$1"
}

is_inside_container() {
  [ -n "${IN_DEVCONTAINER:-}" ] \
    || [ -n "${REMOTE_CONTAINERS:-}" ] \
    || [ -n "${CODESPACES:-}" ] \
    || [ -f /.dockerenv ] \
    || [ -f /run/.containerenv ]
}

main() {
  if is_inside_container; then
    log "Dentro de um container; pulando (deve rodar no host)."
    exit 0
  fi

  if [ ! -f "${MAKE_INFRA_DIR}/Makefile" ]; then
    log "Makefile não encontrado: ${MAKE_INFRA_DIR}/Makefile"
    exit 1
  fi

  log "Rodando 'make up' em ${MAKE_INFRA_DIR}"
  make -C "$MAKE_INFRA_DIR" up
}

main "$@"